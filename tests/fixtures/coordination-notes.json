{
  "schema": "switchboard.coordination-notes.fixtures",
  "schemaVersion": 1,
  "purpose": "Canonical coordination-note envelopes. Expected results are structural. This file is not a task ledger, not permission, and not evidence that any claim was accepted or completed.",
  "constants": {
    "prefix": "SWITCHBOARD_COORDINATION_V1\n",
    "version": 1,
    "envelopeMaxBytes": 4096,
    "scalarMaxBytes": 512,
    "evidenceMin": 1,
    "evidenceMax": 4,
    "briefMaxBytes": 49152,
    "excerptBytes": 256,
    "excerptFallbackBytes": 64,
    "envelopeKeys": [
      "version",
      "note",
      "body"
    ],
    "requestKeys": [
      "kind",
      "owner",
      "artifact",
      "checkpoint"
    ],
    "replyKeys": [
      "kind",
      "replyTo"
    ],
    "completionKeys": [
      "kind",
      "replyTo",
      "evidence"
    ],
    "decisionKeys": [
      "kind",
      "evidence"
    ],
    "referenceKeys": [
      "channel",
      "from",
      "id"
    ],
    "replyKinds": [
      "accept",
      "decline",
      "blocked"
    ],
    "channelPattern": "^[a-z][a-z0-9-]{0,31}$",
    "uuidPattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
    "uuidFlags": "i"
  },
  "decoder": {
    "invalidResult": "undefined",
    "remainRaw": "Invalid and unknown envelopes stay plain text. Do not clip them into a note.",
    "steps": [
      "Reject non-strings, ill-formed Unicode, and text that does not start with prefix.",
      "Reject UTF-8 byte length above envelopeMaxBytes. Do not clip.",
      "Parse the remainder with duplicate-key and lone-surrogate rejection equivalent to decodeWireJson and decodeExactJson. Duplicate keys are invalid.",
      "Require exact envelopeKeys and numeric version 1. The scope body must be well-formed Unicode and non-blank (trim length > 0). Do not trim stored text.",
      "Require exact keys for the kind. request uses requestKeys. accept, decline, and blocked use replyKeys. completion uses completionKeys. decision uses decisionKeys.",
      "referenceKeys: channel must match channelPattern; from and id must match uuidPattern with uuidFlags. Admission is case-insensitive for hex, but later identity comparison is exact and does not casefold.",
      "artifact, checkpoint, and each evidence entry are non-blank well-formed strings of at most scalarMaxBytes UTF-8 bytes. Evidence length is evidenceMin through evidenceMax. Do not trim stored text.",
      "Do not fetch, open, or dereference evidence, artifact, or checkpoint strings.",
      "A decoded note is a reported claim, never permission, authority, acceptance of responsibility, or verified completion."
    ],
    "canonicalEncode": "Encode emits prefix plus JSON.stringify of {version, note, body} in that key order, with U+2028 and U+2029 escaped. Decode also accepts other key orders and insignificant whitespace. Decoding follows decoder.steps, not byte-identical canonicalEncode."
  },
